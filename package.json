{
  "name": "image-files-to-pdf",
  "version": "4.0.0",
  "private": true,
  "description": "Image conversion to PDF through a Node CLI and macOS Finder Quick Action",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resoltico/ImageFilesToPDF.git"
  },
  "homepage": "https://github.com/resoltico/ImageFilesToPDF",
  "author": "Ervins Strauhmanis",
  "engines": {
    "node": ">=26.13.1",
    "npm": ">=12.2.2"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "lint": "node tools/lint.mjs",
    "lint:js": "eslint .",
    "test": "node --test \"tests/unit/**/*.test.cjs\" \"tests/repo/**/*.test.cjs\"",
    "test:coverage": "node tools/unit-gate.mjs coverage",
    "check-dist": "node tools/check-dist.mjs",
    "quality": "npm run lint && npm run lint:js && npm run test:coverage && npm run test:mutation && npm run check-dist",
    "release": "npm run build && npm run quality",
    "test:integration:macos": "bash tests/integration/macos-suite.sh",
    "test:mutation": "node tools/unit-gate.mjs mutation",
    "test:unit": "node --test \"tests/unit/**/*.test.cjs\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/tap-runner": "10.1.1",
    "acorn": "8.19.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "fast-check": "4.10.2"
  },
  "overrides": {
    "qs": "6.17.1",
    "minimatch": "11.0.8",
    "glob": "14.0.6"
  },
  "copyright": "2026 Ervins Strauhmanis",
  "packageManager": "npm@12.2.2"
}
